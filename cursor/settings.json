{
  "security.workspace.trust.untrustedFiles": "open",
  "remote.SSH.enableRemoteCommand": true,
  "remote.SSH.useLocalServer": false,
  "editor.fontSize": 15,
  "editor.fontLigatures": false,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": false,
  "editor.accessibilitySupport": "on",
  "[python]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "python.linting.flake8Args": [
    "--max-line-length=248"
  ],
  "leetcode.endpoint": "leetcode",
  "leetcode.defaultLanguage": "java",
  "leetcode.hint.commandShortcut": false,
  "leetcode.hint.configWebviewMarkdown": false,
  "editor.insertSpaces": false,
  "redhat.telemetry.enabled": true,
  "files.autoSave": "afterDelay",
  "workbench.editorAssociations": {
    "*.out": "hexEditor.hexedit",
    "*.csv": "default",
    "*.tex": "default"
  },
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.default.cStandard": "c23",
  "C_Cpp.default.enableConfigurationSquiggles": false,
  "C_Cpp.intelliSenseEngineFallback": "enabled",
  "C_Cpp.autocompleteAddParentheses": true,
  "C_Cpp.clang_format_fallbackStyle": "Google",
  "git.enableSmartCommit": true,
  "workbench.startupEditor": "none",
  "cSpell.enableFiletypes": [
    "markdown_latex_combined",
    "razor"
  ],
  "cSpell.userWords": [
    "generalizability",
    "subnetwork"
  ],
  "workbench.colorCustomizations": {},
  "github.copilot.editor.enableAutoCompletions": true,
  "workbench.editor.empty.hint": "hidden",
  "git.openRepositoryInParentFolders": "never",
  "cloudcode.autoDependencies": "off",
  "debug.disassemblyView.showSourceCode": false,
  "C_Cpp.intelliSenseEngine": "disabled",
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask"
  ],
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "markdown",
    "scminput"
  ],
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "fish",
  "gitlens.remotes": [],
  "diffEditor.maxComputationTime": 0,
  "remote.SSH.defaultExtensions": [
    "anyscalecompute.anyscale-workspaces",
    "ms-python.python",
    "ms-toolsai.jupyter-renderers",
    "ms-toolsai.jupyter-keymap",
    "ms-toolsai.jupyter"
  ],
  "git.confirmSync": false,
  "flake8.args": [
    "\"flake8.args\": [\"--max-line-length=120\"]"
  ],
  "[csv]": {
    "editor.inlayHints.maximumLength": 0
  },
  "diffEditor.hideUnchangedRegions.enabled": true,
  "jupyter.askForKernelRestart": false,
  "remote.autoForwardPortsSource": "hybrid",
  "claudeCode.preferredLocation": "panel",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/usr/local/texlive/2026/bin/universal-darwin/latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "window.autoDetectColorScheme": false
}
